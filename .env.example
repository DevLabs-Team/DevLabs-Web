# Copia este archivo a .env y rellena los valores
# (los valores de esta versión son de ejemplo)

# ── GitHub OAuth (obligatorio) ──
# Crea una OAuth App en: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# URL de callback. Añade TAMBIÉN esta URL en la OAuth App de GitHub.
# Local:   http://localhost:3000/auth/callback
# Vercel:  https://TU-PROYECTO.vercel.app/auth/callback
GITHUB_CALLBACK_URL=http://localhost:3000/auth/callback

# ── Sesión (obligatorio) ──
# String largo y aleatorio. Genera uno con: openssl rand -hex 32
SESSION_SECRET=

# ── Token de GitHub para listar miembros (recomendado) ──
# Personal Access Token (scope: read:org) del DUEÑO de la org.
# Permite mostrar TODOS los miembros (públicos y privados) sin que
# ningún visitante tenga que iniciar sesión.
# Crea uno en: https://github.com/settings/tokens
GITHUB_TOKEN=

# ── Base de datos (producción) ──
# Tu connection string de Neon (Postgres). Lo encuentras en tu proyecto Neon.
DATABASE_URL=

# ── Servidor ──
PORT=3000
